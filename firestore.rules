rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['displayName','createdAt','updatedAt','assessmentCompleted','difficultyPreference'])
                    && request.resource.data.difficultyPreference in ['beginner','normal','challenge'];
      allow delete: if false;

      match /skillProfiles/{skill} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                    && skill in ['reading','listening','writing','speaking','understanding']
                    && request.resource.data.level in ['L1','L2','L3','L4','L5']
                    && request.resource.data.confidence in ['low','medium','high']
                    && request.resource.data.source in ['assessment','self_selected','adaptive_update','default']
                    && request.resource.data.startingDifficulty in ['easy','medium','hard'];
        allow delete: if false;
      }

      match /practiceResults/{resultId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Practice results are an append-only history — never edited or removed.
        allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['sessionId','questionId','skill','difficulty','answer','referenceAnswer','pattern','evaluation','score','correct','responseTimeMs','createdAt'])
                    && request.resource.data.skill in ['reading','listening','writing','speaking','understanding']
                    && request.resource.data.difficulty in ['easy','medium','hard']
                    && request.resource.data.evaluation in ['correct','incorrect'];
        allow update, delete: if false;
      }

      match /learningState/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid && docId == 'current';
        allow delete: if false;
      }

      match /patternMastery/{patternId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['pattern','attempts','correct','masteryPct'])
                    && request.resource.data.attempts is int && request.resource.data.attempts >= 0
                    && request.resource.data.correct is int && request.resource.data.correct >= 0
                    && request.resource.data.masteryPct is int
                    && request.resource.data.masteryPct >= 0 && request.resource.data.masteryPct <= 100;
        allow delete: if false;
      }

      match /reviewSchedule/{questionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['questionId','skill','masteryScore','reviewCount','consecutiveCorrect','intervalDays','lastReviewedAt','nextReviewAt'])
                    && request.resource.data.skill in ['reading','listening','writing','speaking','understanding']
                    && request.resource.data.masteryScore is int && request.resource.data.masteryScore >= 0 && request.resource.data.masteryScore <= 100
                    && request.resource.data.reviewCount is int && request.resource.data.reviewCount >= 0
                    && request.resource.data.consecutiveCorrect is int && request.resource.data.consecutiveCorrect >= 0
                    && request.resource.data.intervalDays is int && request.resource.data.intervalDays >= 0;
        allow delete: if false;
      }
    }
  }
}
