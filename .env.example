# Firebase web app config (from Firebase Console > Project settings > Your apps > Web).
# These values are not secret — Firebase security comes from Firestore Security Rules,
# not from hiding this config. Safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
